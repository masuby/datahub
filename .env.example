# ─────────────────────────────────────────────────────────────
# DataHub — environment configuration
# Copy to ".env" (local dev) and ".env.production" / compose env (server).
# NEVER commit real secrets. .env files are git-ignored.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO/canonical metadata)
NEXT_PUBLIC_SITE_URL="https://www.datahub.co.tz"

# Public contact email shown on the page (safe to expose)
NEXT_PUBLIC_CONTACT_EMAIL=hello@datahub.co.tz

# ── WhatsApp (public — shown on the site) ────────────────────
# Digits only, with country code and no "+" or spaces. Tanzania = 255.
# e.g. 0712 345 678  ->  255712345678
# Leave EMPTY to hide every WhatsApp button on the site.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# How the number is displayed to visitors (optional; defaults to +<number>)
NEXT_PUBLIC_WHATSAPP_DISPLAY=
# First message pre-filled in the visitor's WhatsApp (optional)
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello DataHub, I saw your post and I would like to talk about dashboards / automation for my business.

# ── Database (self-hosted PostgreSQL) ────────────────────────
# In docker-compose this points at the "db" service host.
DATABASE_URL="postgresql://datahub:CHANGE_ME_STRONG_PASSWORD@db:5432/datahub?schema=public"

# ── Email notifications (SMTP — e.g. Gmail SMTP, same as PCL) ─
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"                       # 465 (SSL) or 587 (STARTTLS)
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-app-password"         # Gmail App Password, not your login password
SMTP_FROM="your-account@gmail.com"
CONTACT_NOTIFY_EMAIL="wwwdanielclement468@gmail.com"   # where leads are delivered

# ── Rate limiting ────────────────────────────────────────────
# Optional Redis (shared, persistent). If unset, an in-memory limiter is used.
REDIS_URL="redis://redis:6379"
RATE_LIMIT_MAX="5"                    # max submissions per window per IP
RATE_LIMIT_WINDOW_SECONDS="600"       # window length in seconds (10 min)

# ── Security ─────────────────────────────────────────────────
# Random secret used to salt hashed IPs (so raw IPs are never stored).
# Generate: openssl rand -hex 32
IP_HASH_SALT="CHANGE_ME_RANDOM_HEX"

# ── Postgres container credentials (used by docker-compose) ──
POSTGRES_USER="datahub"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
POSTGRES_DB="datahub"
