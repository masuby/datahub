# =============================================================================
# DataHub — environment configuration TEMPLATE
# =============================================================================
# This file is COMMITTED TO GIT and the repository is PUBLIC.
# Never put a real password, database URL, API key or salt in this file.
#
# Real values belong in:
#   • .env                 — local development (git-ignored)
#   • Vercel → Settings → Environment Variables → Production  (the live site)
#   • the server's own .env next to docker-compose.yml (self-hosted path)
#
# Every variable below is referenced by the code. The list was derived from
# `process.env.*` in src/, env() in prisma/schema.prisma, and the interpolations
# in docker-compose.yml — it is complete, not illustrative.
#
# FILL ME IN markers are the only values you must supply yourself.
# =============================================================================


# -----------------------------------------------------------------------------
# Public values — inlined into the browser bundle at BUILD time.
# -----------------------------------------------------------------------------
# These are visible to every visitor by design. Nothing secret may go here.
# Because they are inlined at build time, CHANGING ONE REQUIRES A REDEPLOY —
# saving the variable alone has no effect on the live site.

# Canonical site URL. Used for SEO metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL="https://www.datahub.co.tz"

# Contact address displayed on the page.
NEXT_PUBLIC_CONTACT_EMAIL="hello@datahub.co.tz"

# WhatsApp number, digits only: country code, no "+", no spaces.
# Tanzania = 255, so 0622 890 230 becomes 255622890230.
# Leave EMPTY to hide every WhatsApp button on the site.
NEXT_PUBLIC_WHATSAPP_NUMBER="255622890230"

# How that number is shown to visitors. Optional; defaults to "+<number>".
NEXT_PUBLIC_WHATSAPP_DISPLAY="+255 622 890 230"

# First message pre-filled in the visitor's WhatsApp. Optional.
NEXT_PUBLIC_WHATSAPP_MESSAGE="Hello DataHub, I saw your post and I would like to talk about dashboards / automation for my business."


# -----------------------------------------------------------------------------
# Database — PostgreSQL (secret)
# -----------------------------------------------------------------------------
# Production runs on Neon. Use the POOLED connection string (the host contains
# "-pooler"); serverless functions open many short-lived connections and will
# exhaust a direct one.
#
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
# Special characters in the password must be URL-encoded: @ → %40, : → %3A,
# / → %2F, # → %23.
#
# Self-hosted (docker compose) uses the internal hostname instead:
#   postgresql://datahub:PASSWORD@db:5432/datahub?schema=public
DATABASE_URL="FILL ME IN"

# Only needed if `prisma migrate deploy` fails against the pooled URL. Set it to
# the DIRECT (non-pooled) connection string and add a matching
# `directUrl = env("DIRECT_URL")` line to prisma/schema.prisma.
# Currently NOT required — migrations apply fine through the pooler.
# DIRECT_URL=""


# -----------------------------------------------------------------------------
# Outbound email — SMTP (password is secret)
# -----------------------------------------------------------------------------
# Sends the lead-notification email. Failure here never fails the request; the
# lead is saved first and a send error is only logged.
#
# Two valid setups:
#
#   A) Purelymail — sends as the domain, so SPF/DKIM align and the From header
#      is not rewritten. Note Purelymail GREYLISTS unfamiliar senders, which can
#      delay the first message from a new source.
#         SMTP_HOST="smtp.purelymail.com"
#         SMTP_USER="hello@datahub.co.tz"
#         SMTP_FROM="hello@datahub.co.tz"
#
#   B) Gmail — requires an App Password, not the account password. Gmail
#      rewrites SMTP_FROM to the authenticated account, so the notification
#      arrives from your Gmail address. Since these notifications are only ever
#      sent to you, that is cosmetic — and it avoids greylisting delays.
#         SMTP_HOST="smtp.gmail.com"
#         SMTP_USER="your-account@gmail.com"
#
# Production currently uses (B) so lead alerts arrive instantly.
SMTP_HOST="smtp.purelymail.com"
SMTP_PORT="465"                        # 465 = implicit SSL, 587 = STARTTLS
SMTP_USER="hello@datahub.co.tz"
SMTP_PASS="FILL ME IN"                 # mailbox password, or an app password
SMTP_FROM="hello@datahub.co.tz"        # must be an address SMTP_USER may send as

# Where lead notifications are delivered. PRIVATE — never shown on the site, so
# a personal inbox is fine and is usually seen fastest.
CONTACT_NOTIFY_EMAIL="FILL ME IN"


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Redis is optional. When REDIS_URL is unset or unreachable the limiter falls
# back to an in-process memory window.
#
# ON VERCEL: LEAVE THIS EMPTY unless it points at a real reachable host such as
# Upstash. Each serverless instance has its own memory, so the fallback limiter
# barely constrains a distributed attacker — the honeypot and Zod validation do
# most of the work. Pointing it at the docker hostname "redis" simply fails.
#
# Self-hosted (docker compose): redis://redis:6379
REDIS_URL=""

RATE_LIMIT_MAX="5"                     # submissions allowed per window, per IP
RATE_LIMIT_WINDOW_SECONDS="600"        # window length in seconds (600 = 10 min)


# -----------------------------------------------------------------------------
# Security (secret)
# -----------------------------------------------------------------------------
# Salts the SHA-256 hash of each submitter's IP. The raw IP is never stored.
# Changing this makes previously stored hashes uncomparable — set it once.
#
# Generate a fresh 32-byte hex value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
IP_HASH_SALT="FILL ME IN"


# -----------------------------------------------------------------------------
# Postgres container — SELF-HOSTED (docker compose) ONLY
# -----------------------------------------------------------------------------
# Not used on Vercel; ignore this block entirely if you only deploy there.
# POSTGRES_PASSWORD must match the password inside DATABASE_URL above.
POSTGRES_USER="datahub"
POSTGRES_PASSWORD="FILL ME IN"
POSTGRES_DB="datahub"
